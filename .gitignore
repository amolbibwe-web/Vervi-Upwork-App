#  so a hosted instance still recognises what was already journalised)
fx_cache.csv
out/
exports/
# (exports_seed/ IS committed, at the owner's explicit request, so the hosted
#  app shows the converted-statement list. It holds client names and amounts,
#  and this repo is public.)
publish/

